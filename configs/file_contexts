# aimg sample file_contexts
# format: <path regex> <selinux context> [file type]
# matching: longest literal prefix wins, ties go to the later rule.

/                    u:object_r:rootfs:s0
/system(/.*)?        u:object_r:system_file:s0
/system/bin/sh       u:object_r:shell_exec:s0
/system/bin/toybox   u:object_r:toybox_exec:s0
/system/bin/app_process u:object_r:zygote_exec:s0
/system/bin/su       u:object_r:su_exec:s0
/system/etc/init(/.*)? u:object_r:system_file:s0
/system/app(/.*)?    u:object_r:system_app_file:s0
/system/priv-app(/.*)? u:object_r:system_priv_app_file:s0
/system/lib64(/.*)?  u:object_r:system_lib_file:s0
/vendor(/.*)?        u:object_r:vendor_file:s0
/vendor/bin(/.*)?    u:object_r:vendor_exec_file:s0
/product(/.*)?       u:object_r:system_file:s0
